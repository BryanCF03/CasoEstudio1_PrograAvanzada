@model IEnumerable<Habitaciones.LogicaDeNegocio.DTO.HabitacionDTO>

@{
    ViewBag.Title = "Listado de Habitaciones";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Listado de Habitaciones</h2>
            <p class="text-muted">
                Consulta las habitaciones registradas en el sistema.
            </p>
        </div>

        <a href="@Url.Action("Create", "Habitaciones")"
           class="btn btn-primary">
            Registrar habitación
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Mensaje"]

            <button type="button"
                    class="close"
                    data-dismiss="alert"
                    aria-label="Cerrar">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">

                <thead class="thead-dark">
                    <tr>
                        <th>Código</th>
                        <th>Habitación</th>
                        <th>Ubicación</th>
                        <th>Huéspedes</th>
                        <th>Camas</th>
                        <th>Baños</th>
                        <th>Encargado de limpieza</th>
                        <th>Tipo de habitación</th>
                        <th>Costo de limpieza</th>
                        <th>Costo de reserva</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var habitacion in Model)
                    {
                        <tr>
                            <td>@habitacion.CodigoDeHabitacion</td>

                            <td>@habitacion.NombreDeHabitacion</td>

                            <td>@habitacion.Ubicacion</td>

                            <td>@habitacion.CantidadDeHuespedesPermitidos</td>

                            <td>@habitacion.CantidadDeCamas</td>

                            <td>@habitacion.CantidadDeBanos</td>

                            <td>@habitacion.EncargadoDeLimpieza</td>

                            <td>
                                @switch (habitacion.TipoDeHabitacion)
                                {
                                    case 1:
                                        @:Junior
                                        break;

                                    case 2:
                                        @:Superior
                                        break;

                                    case 3:
                                        @:Suite
                                        break;

                                    default:
                                        @:No definido
                                        break;
                                }
                            </td>

                            <td>₡ @habitacion.CostoDeLimpieza.ToString("N2")</td>

                            <td>₡ @habitacion.CostoDeReserva.ToString("N2")</td>

                            <td>
                                @if (habitacion.Estado)
                                {
                                    <span class="label label-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="label label-danger">
                                        Inactiva
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay habitaciones registradas para mostrar.
        </div>
    }

</div>
