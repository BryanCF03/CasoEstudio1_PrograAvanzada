@model IEnumerable<Reservaciones.Abstracciones.ModelosParaUI.HabitacionReservaDto>

@{
    ViewBag.Title = "Habitaciones disponibles";
}

<div class="container">
    <h2>Habitaciones disponibles</h2>
    <p>Seleccione una habitación para realizar su reservación.</p>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info">
            @TempData["Mensaje"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            Actualmente no hay habitaciones disponibles.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Habitación</th>
                        <th>Tipo</th>
                        <th>Huéspedes</th>
                        <th>Camas</th>
                        <th>Baños</th>
                        <th>Ubicación</th>
                        <th>Reserva por día</th>
                        <th>Limpieza</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var habitacion in Model)
                    {
                        <tr>
                            <td>@habitacion.CodigoDeHabitacion</td>
                            <td>@habitacion.NombreDeHabitacion</td>
                            <td>@habitacion.TipoDeHabitacion</td>
                            <td>@habitacion.CantidadDeHuespedesPermitidos</td>
                            <td>@habitacion.CantidadDeCamas</td>
                            <td>@habitacion.CantidadDeBanos</td>
                            <td>@habitacion.Ubicacion</td>
                            <td>@habitacion.CostoDeReserva.ToString("C")</td>
                            <td>@habitacion.CostoDeLimpieza.ToString("C")</td>
                            <td>
                                @Html.ActionLink(
                                    "Reservar",
                                    "Reservar",
                                    "Reservaciones",
                                    new { idHabitacion = habitacion.Id },
                                    new { @class = "btn btn-primary btn-sm" }
                                )
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink(
            "Buscar reservación",
            "BuscarReserva",
            "Reservaciones",
            null,
            new { @class = "btn btn-secondary" }
        )
    </div>
</div>
