@model Reservaciones.Abstracciones.ModelosParaUI.ReservacionDto

@{
    ViewBag.Title = "Reservar habitación";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <h2>Reservar habitación</h2>
            <p>Complete los datos para realizar su reservación.</p>
            <hr />

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm(
                "Reservar",
                "Reservaciones",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    false,
                    "",
                    new { @class = "text-danger" })

                @Html.HiddenFor(m => m.IdHabitacion)

                <h4>Información de la habitación</h4>

                <div class="form-group">
                    @Html.LabelFor(m => m.CodigoDeHabitacion, "Código")
                    @Html.TextBoxFor(
                        m => m.CodigoDeHabitacion,
                        new { @class = "form-control", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.NombreDeHabitacion, "Habitación")
                    @Html.TextBoxFor(
                        m => m.NombreDeHabitacion,
                        new { @class = "form-control", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <label>Tipo de habitación</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.TipoDeHabitacionEnProsa"
                           readonly />
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        m => m.CantidadDeHuespedesPermitidos,
                        "Huéspedes permitidos")

                    @Html.TextBoxFor(
                        m => m.CantidadDeHuespedesPermitidos,
                        new { @class = "form-control", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    <label>Costo de reserva por día</label>
                    <input type="text"
                           class="form-control"
                           value="@string.Format(
                               System.Globalization.CultureInfo.GetCultureInfo("es-CR"),
                               "{0:C}",
                               ViewBag.CostoDeReserva)"
                           readonly />
                </div>

                <div class="form-group">
                    <label>Costo de limpieza</label>
                    <input type="text"
                           class="form-control"
                           value="@string.Format(
                               System.Globalization.CultureInfo.GetCultureInfo("es-CR"),
                               "{0:C}",
                               ViewBag.CostoDeLimpieza)"
                           readonly />
                </div>

                <hr />

                <h4>Información del huésped</h4>

                <div class="form-group">
                    @Html.LabelFor(m => m.NombreDeLaPersona, "Nombre completo")
                    @Html.TextBoxFor(
                        m => m.NombreDeLaPersona,
                        new
                             {
                            @class = "form-control",
                            placeholder = "Ingrese su nombre completo",
                            required = "required"
                        })
                    @Html.ValidationMessageFor(
                        m => m.NombreDeLaPersona,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Identificacion, "Identificación")
                    @Html.TextBoxFor(
                        m => m.Identificacion,
                        new
                             {
                            @class = "form-control",
                            placeholder = "Número de identificación",
                            required = "required"
                        })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Telefono, "Teléfono")
                    @Html.TextBoxFor(
                        m => m.Telefono,
                        new
                             {
                            @class = "form-control",
                            type = "tel",
                            placeholder = "Número de teléfono",
                            required = "required"
                        })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Correo, "Correo electrónico")
                    @Html.TextBoxFor(
                        m => m.Correo,
                        new
                             {
                            @class = "form-control",
                            type = "email",
                            placeholder = "correo@ejemplo.com",
                            required = "required"
                        })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.FechaNacimiento, "Fecha de nacimiento")
                    @Html.TextBoxFor(
                        m => m.FechaNacimiento,
                        "{0:yyyy-MM-dd}",
                        new
                             {
                            @class = "form-control",
                            type = "date",
                            required = "required"
                        })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Direccion, "Dirección")
                    @Html.TextAreaFor(
                        m => m.Direccion,
                        new
                             {
                            @class = "form-control",
                            rows = "3",
                            placeholder = "Ingrese su dirección",
                            required = "required"
                        })
                </div>

                <hr />

                <h4>Fechas de reservación</h4>

                <div class="form-group">
                    @Html.LabelFor(
                        m => m.FechaInicioReserva,
                        "Fecha de entrada")

                    @Html.TextBoxFor(
                        m => m.FechaInicioReserva,
                        "{0:yyyy-MM-dd}",
                        new
                             {
                            @class = "form-control",
                            type = "date",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.FechaInicioReserva,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        m => m.FechaFinReserva,
                        "Fecha de salida")

                    @Html.TextBoxFor(
                        m => m.FechaFinReserva,
                        "{0:yyyy-MM-dd}",
                        new
                             {
                            @class = "form-control",
                            type = "date",
                            required = "required"
                        })

                    @Html.ValidationMessageFor(
                        m => m.FechaFinReserva,
                        "",
                        new { @class = "text-danger" })
                </div>

                <hr />

                <button type="submit" class="btn btn-primary">
                    Confirmar reservación
                </button>

                @Html.ActionLink(
                    "Volver a habitaciones",
                    "ListarHabitacionesDisponibles",
                    "Reservaciones",
                    null,
                    new { @class = "btn btn-default" })
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
